{
  "name": "@org/email-worker",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "app/email-worker",
        "command": "tsc -b"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "app/email-worker",
        "command": "NODE_OPTIONS=\"--conditions=@org/source\" tsx watch --clear-screen=false src/main.ts"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "app/email-worker",
        "command": "node ./dist/main.js"
      }
    }
  }
}
