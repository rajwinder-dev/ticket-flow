{
  "name": "@org/email-worker",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "app/email-worker",
        "command": "tsc -b"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "app/email-worker",
        "command": "tsx watch src/main.ts"
      }
    }
  }
}
