{
  "name": "@org/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node ./dist/main.js"
  },
  "nx": {
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/app/api/dist/package.json",
          "{workspaceRoot}/app/api/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/app/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@org/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@org/api:build:development"
          },
          "production": {
            "buildTarget": "@org/api:build:production"
          }
        }
      }
    }
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.4",
    "@opentelemetry/api": "^1.9.1",
    "@org/constants": "workspace:*",
    "@org/database": "workspace:*",
    "@org/email-providers": "workspace:*",
    "@org/utils": "workspace:*",
    "@org/zod": "workspace:*",
    "@sentry/node": "^10.65.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/hpp": "^0.2.7",
    "@types/morgan": "^1.9.10",
    "@types/qs": "^6.15.1",
    "@types/sanitize-html": "^2.16.1",
    "better-auth": "^1.6.23",
    "bullmq": "^5.79.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "morgan": "^1.11.0",
    "nanoid": "^5.1.16",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-roll": "^4.0.0",
    "qs": "^6.15.3",
    "sanitize-html": "^2.17.5",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3"
  }
}
