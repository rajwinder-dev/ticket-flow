{
  "name": "@org/api",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "app/api",
        "command": "tsc -b"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch src/main.ts",
        "cwd": "app/api"
      }
    }
  }
}
