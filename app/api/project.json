{
  "name": "@org/api",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "app/api",
        "command": "tsc -b"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "app/api",
        "command": "NODE_OPTIONS=\"--conditions=@org/source\" tsx watch --clear-screen=false  --inspect  --inspect src/main.ts"
      }
    }
  }
}
