import { UpdateMyDetailsInput } from '@org/zod';
import { appError } from '../../core/utils/appError.js';
import { prisma } from '@org/database';

export class UserService {
  static getDetails = async (userId: string) => {
    const user = await prisma.user.findUnique({
      where: {
        id: userId,
      },
    });
    if (!user) throw new appError('User missing after auth', 400);

    return user;
  };
  static updateDetails = async (
    userId: string,
    input: UpdateMyDetailsInput,
  ) => {
    const updatedUser = await prisma.user.update({
      data: input,
      where: {
        id: userId,
      },
    });
    return updatedUser;
  };
  static checkExist = async ({
    email,
    username,
  }: {
    email: string;
    username: string;
  }) => {
    const existingUsers = await prisma.user.findMany({
      where: {
        OR: [{ email }, { username }],
      },
      select: {
        email: true,
        username: true,
      },
    });

    const conflicts: string[] = [];

    for (const user of existingUsers) {
      if (user.email === email) conflicts.push('email');
      if (user.username === username) conflicts.push('username');
    }
    return conflicts;
  };
}
