{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".env", ".env.local", ".env.production", ".env.development"],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "REDIS_PORT",
    "REDIS_HOST",
    "REDIS_PASSWORD",
    "ENCRYPTION_KEY",
    "DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
