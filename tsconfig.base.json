{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@repo/types": ["packages/schemas/src/index.ts"],
      "@repo/types/*": ["packages/schemas/src/*"],
      "@repo/constants": ["packages/constants"]
    }
  }
}
