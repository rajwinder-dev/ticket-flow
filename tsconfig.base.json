{
  "compilerOptions": {
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      "@repo/constants": [
        "./packages/constants/src"
      ],
      "@repo/schemas": [
        "./packages/schemas/src"
      ],
      "@repo/database": [
        "./packages/database/src"
      ],
      "@repo/utils": [
        "./packages/utils/src"
      ],
    },
    "target": "ES2022",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true, // Recommended to avoid type errors in node_modules
    "composite": true,
  }
}
