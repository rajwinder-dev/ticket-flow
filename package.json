{
  "name": "ticket-system",
  "private": true,
  "scripts": {
  "dev": "pnpm -r --parallel dev",
    "dev:backend": "pnpm --filter backend dev",
    "debug:backend": "pnpm --filter backend debug",
    "dev:frontend": "pnpm --filter frontend dev",
    "shadcn": "pnpm --filter frontend shadcn:add",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "push": "pnpm --filter backend db:push",
    "clear": "pnpm --filter backend db:clear",
    "seed": "pnpm --filter backend db:seed",
    "migrate": "pnpm --filter backend db:migrate"
  },
  "engines": {
    "node": "=20"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  }
}
