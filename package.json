{
  "name": "ticket-system",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "packages/*"
  ],
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env -- turbo dev",
    "build": "dotenv -e .env -- turbo build",
    "start": "dotenv -e .env -- turbo start",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "db:push": "pnpm --filter database db:push",
    "db:clear": "pnpm --filter backend db:clear",
    "db:seed": "pnpm --filter backend db:seed",
    "db:deploy": "pnpm --filter database db:deploy",
    "db:generate": "turbo run  db:generate",
    "db:migrate": "pnpm --filter database db:migrate",
    "db:setup": "pnpm --filter database db:setup"
  },
  "engines": {
    "node": "=20",
    "pnpm": "^9"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  }
}
