{
  "name": "ticket-system",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "packages/*"
  ],
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "db:push": "pnpm --filter database db:push",
    "db:clear": "pnpm --filter database db:clear",
    "db:seed": "pnpm --filter database db:seed",
    "db:migrate": "pnpm --filter database db:migrate",
    "db:generate": "pnpm --filter database db:generate",
    "db:setup": "pnpm --filter database db:setup"
  },
  "engines": {
    "node": "=20",
    "pnpm": "^9"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.9.14",
    "typescript": "^6.0.2"
  }
}
