generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//  ============================ ENUMS ==============================

//  ============================ USERS / ROLES / ORG ==============================

model User {
  id                String             @id @default(uuid()) @db.Uuid
  code              String             @unique
  email             String             @unique
  phoneNo           String?            @unique
  passwordHash      String
  passwordChangeAt  DateTime?
  avatar            String?
  username          String?
  location          String?
  active            Boolean            @default(true)
  isOnboarded       Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  creator           User?              @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdBy         String?            @db.Uuid
  createdUsers      User[]             @relation("UserCreatedBy")
  activityLogs      ActivityLog[]
  sessions          Session[]
  assignedProjects  AssignedProject[]
  managedProjects   Project[]          @relation("ProjectManager")
  createdRoles      Role[]             @relation("RoleCreatedBy")
  ticketsAssigned   Ticket[]           @relation("TicketAssignedTo")
  ticketsCreated    Ticket[]           @relation("TicketAssignedBy")
  ticketComments    TicketComment[]
  fromTransitions   TicketTransition[] @relation("TransitionFromEmployee")
  toTransitions     TicketTransition[] @relation("TransitionToEmployee")
  notificationFrom  Notification[]     @relation("NotificationFrom")
  notificationTo    Notification[]     @relation("NotificationTo")
  chatRoomsCreated  ChatRoom[]         @relation("ChatCreatedBy")
  participants      Participant[]
  messages          Message[]
  organization      Organization[]
  membership        Membership[]
  token             Token[]
  TokenCreatedBy    Token[]            @relation("TokenCreatedBy")
  queueAgents       QueueAgent[]
  queueGroups       QueueGroup[]
  ticketTransitions TicketTransition[]
}

model Organization {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  teamSize      Int?
  code          String          @unique
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User?           @relation(fields: [createdBy], references: [id])
  createdBy     String          @db.Uuid
  tickets       Ticket[]
  membership    Membership[]
  role          Role[]
  tokens        Token[]
  email         EmailProvider[]
  customer      Customer[]
  emailMessages EmailMessage[]
  queues        Queue[]
  queueAgents   QueueAgent[]
  queueGroups   QueueGroup[]
  attachments   Attachment[]
}

model Membership {
  id             String        @id @default(uuid()) @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String        @db.Uuid
  user           User?         @relation(fields: [userId], references: [id])
  userId         String        @db.Uuid
  role           Role?         @relation(fields: [roleId], references: [id])
  roleId         String        @db.Uuid

  @@unique([organizationId, userId])
}

model Role {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique
  name             String
  description      String?
  permissions      Json
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  creator          User?             @relation("RoleCreatedBy", fields: [createdBy], references: [id])
  createdBy        String            @db.Uuid
  organization     Organization?     @relation(fields: [organizationId], references: [id])
  organizationId   String            @db.Uuid
  assignedProjects AssignedProject[]
  membership       Membership[]
  tokens           Token[]
}

enum TokenType {
  INVITE_USER
  RESET_PASSWORD
  CHANGE_EMAIL
  CHANGE_USERNAME
  VERIFY_EMAIL
}

enum TokeStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

model Token {
  id             String        @id @default(uuid())
  email          String
  token          String        @unique
  type           TokenType
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?       @db.Uuid
  role           Role?         @relation(fields: [roleId], references: [id])
  roleId         String?       @db.Uuid
  status         TokeStatus    @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User?         @relation(fields: [userId], references: [id])
  userId         String?       @db.Uuid
  TokenCreatedBy User?         @relation("TokenCreatedBy", fields: [createdBy], references: [id])
  createdBy      String        @db.Uuid
  meteData       Json?
}

enum ProviderType {
  SMTP
  RESEND
  MAILTRAP
}

// ================================= EMAIL ===================================
model EmailProvider {
  id             String        @id @default(uuid())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String        @db.Uuid
  providerType   ProviderType
  isPrimary      Boolean       @default(false)
  active         Boolean       @default(true)
  credentials    Json
  webhookSecret  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  from           String        @unique

  @@unique([organizationId, credentials, providerType])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model EmailMessage {
  id             String           @id @default(uuid()) @db.Uuid
  ticketId       String           @db.Uuid
  ticket         Ticket           @relation(fields: [ticketId], references: [id])
  organizationId String           @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id])
  direction      MessageDirection
  fromEmail      String           @db.VarChar(255)
  toEmail        String           @db.VarChar(255)
  subject        String           @db.VarChar(500)
  bodyHtml       String?          @db.Text
  bodyText       String?          @db.Text
  messageId      String           @unique @db.VarChar(255)
  inReplyTo      String?          @db.VarChar(255)
  references     String?          @db.Text
  createdAt      DateTime         @default(now())

  @@index([ticketId])
  @@index([organizationId])
  @@index([messageId])
}

//  ============================ CUSTOMER ==============================
model CustomerIdentity {
  id       String     @id @default(uuid()) @db.Uuid
  email    String     @unique @db.VarChar(255)
  customer Customer[]
}

model Customer {
  id             String           @id @default(uuid()) @db.Uuid
  identityId     String           @db.Uuid
  identity       CustomerIdentity @relation(fields: [identityId], references: [id])
  organizationId String           @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id])
  name           String?          @db.VarChar(255)
  isActive       Boolean          @default(true)

  tickets Ticket[]

  // One identity can only have one profile per organization.
  @@unique([organizationId, identityId])
}

//  ============================ QUEUE / SLA ==============================
model QueueGroup {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String        @db.Uuid
  default        Boolean       @default(false)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      String?       @db.Uuid
  creator        User?         @relation(fields: [createdBy], references: [id])
  queues         Queue[]

  @@unique([organizationId, name, default])
}

enum priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Queue {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  organizationId String       @db.Uuid
  order          Int
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  queueAgents    QueueAgent[]
  ticket         Ticket[]
  queueGroup     QueueGroup?  @relation(fields: [queueGroupId], references: [id])
  queueGroupId   String?      @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name, order])
}

model QueueAgent {
  id             String        @id @default(uuid()) @db.Uuid
  user           User?         @relation(fields: [agentId], references: [id])
  agentId        String        @db.Uuid
  queue          Queue?        @relation(fields: [queueId], references: [id])
  queueId        String        @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String        @db.Uuid
  ticketCount    Int           @default(0)

  @@unique([queueId, agentId])
}

//  ============================ TICKET MANAGEMENT ==============================
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  REOPENED
  CLOSED
}

model Ticket {
  id             String             @id @default(uuid()) @db.Uuid
  code           String             @unique
  subject        String
  category       String?
  description    String             @db.Text
  status         TicketStatus       @default(OPEN)
  priority       Priority           @default(MEDIUM)
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  organizationId String?            @db.Uuid
  queue          Queue?             @relation(fields: [queueId], references: [id])
  queueId        String?            @db.Uuid
  customer       Customer?          @relation(fields: [customerId], references: [id])
  customerId     String?            @db.Uuid
  assignedToUser User?              @relation("TicketAssignedTo", fields: [assignedTo], references: [id])
  assignedTo     String?            @db.Uuid
  assignedByUser User?              @relation("TicketAssignedBy", fields: [assignedBy], references: [id])
  assignedBy     String?            @db.Uuid
  transitions    TicketTransition[]
  comments       TicketComment[]
  emailMessages  EmailMessage[]
  attachments    Attachment[]

  @@index([assignedTo, assignedBy, customerId, organizationId])
}

model Attachment {
  id             String       @id @default(uuid()) @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String       @db.Uuid
  fileName       String
  fileUrl        String
  fileSize       Int
  mimeType       String
  ticket         Ticket?      @relation(fields: [ticketId], references: [id])
  ticketId       String?      @db.Uuid
  messageId      String?      @db.Uuid
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([ticketId])
  @@index([messageId])
}

model TicketComment {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @db.Uuid
  authorId   String   @db.Uuid
  comment    String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  author     User     @relation(fields: [authorId], references: [id])
}

model TicketTransition {
  id String @id @default(uuid()) @db.Uuid

  ticketId       String        @db.Uuid
  ticket         Ticket        @relation(fields: [ticketId], references: [id])
  action         String // ASSIGNED | ESCALATED | STATUS_CHANGED | etc
  fromQueueId    String?       @db.Uuid
  toQueueId      String?       @db.Uuid
  fromEmployeeId String?       @db.Uuid
  toEmployeeId   String?       @db.Uuid
  fromEmployee   User?         @relation("TransitionFromEmployee", fields: [fromEmployeeId], references: [id])
  toEmployee     User?         @relation("TransitionToEmployee", fields: [toEmployeeId], references: [id])
  changedById    String?       @db.Uuid
  changedBy      User?         @relation(fields: [changedById], references: [id])
  fromPriority   Priority?
  toPriority     Priority?
  fromStatus     TicketStatus?
  toStatus       TicketStatus?

  note String?

  createdAt DateTime @default(now())
}

//  ============================ ACTIVITY / SESSIONS ==============================

model ActivityLog {
  id            String   @id @default(uuid()) @db.Uuid
  entityName    String?
  entityId      String?
  action        String
  description   String?
  logStatus     String?
  metaData      Json?
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  performedById String?  @db.Uuid
  performer     User?    @relation(fields: [performedById], references: [id])
}

model Session {
  id        String   @id
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

//  !============================ EXTRA TABLES NOT USEABLE YET==============================

//  ============================ NOTIFICATIONS ==============================

model Notification {
  id        String   @id @unique @default(uuid())
  message   String
  isRead    Boolean  @default(false)
  fromId    String?  @db.Uuid
  toId      String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  fromUser  User?    @relation("NotificationFrom", fields: [fromId], references: [id])
  toUser    User?    @relation("NotificationTo", fields: [toId], references: [id])
}

//  !============================ EXTRA TABLES NOT USEABLE YET==============================

//  ============================ CHATS / ROOMS ==============================

model ChatRoom {
  id           String        @id @unique @default(uuid())
  chatId       String        @unique
  chatType     String
  roomName     String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  createdBy    String        @db.Uuid
  creator      User          @relation("ChatCreatedBy", fields: [createdBy], references: [id])
  participants Participant[]
  messages     Message[]
}

//  !============================ EXTRA TABLES NOT USEABLE YET==============================

model Participant {
  id        String   @id @unique @default(uuid())
  chatId    String
  userId    String   @db.Uuid
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  chatRoom  ChatRoom @relation(fields: [chatId], references: [chatId])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([chatId, userId])
}

//  !============================ EXTRA TABLES NOT USEABLE YET==============================

model Message {
  id          String    @id @unique @default(uuid())
  chatId      String
  senderId    String    @db.Uuid
  message     String    @db.Text
  iv          String
  tag         String
  isDelivered Boolean   @default(false)
  isRead      Boolean   @default(false)
  isArchived  Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  chatRoom    ChatRoom  @relation(fields: [chatId], references: [chatId])
  sender      User      @relation(fields: [senderId], references: [id])
}

//  !============================ EXTRA TABLES NOT USEABLE YET==============================

model Project {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique @db.Uuid
  name             String?
  description      String?
  priority         Priority          @default(MEDIUM)
  tags             Json?
  isDraft          Boolean           @default(true)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  managerId        String?           @db.Uuid
  manager          User?             @relation("ProjectManager", fields: [managerId], references: [id])
  assignedProjects AssignedProject[]

  @@index([id, code])
}

//  !============================ EXTRA TABLES NOT USEABLE YET==============================

model AssignedProject {
  id         String   @id @default(uuid()) @db.Uuid
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String   @db.Uuid
  projectId  String   @db.Uuid
  roleId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])

  @@index([projectId, roleId])
}
