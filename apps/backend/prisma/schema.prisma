generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//  ============================ ENUMS ==============================

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}

//  ============================ USERS / ROLES / ORG ==============================

model User {
  id               String             @id @unique @default(uuid())
  code             String             @unique
  email            String             @unique
  phoneNo          String?            @unique
  passwordHash     String             @unique
  passwordChangeAt DateTime?
  avatar           String?
  username         String?
  location         String?
  active           Boolean            @default(true)
  isOnboarded      Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  managerId        String?            @db.VarChar(128)
  createdBy        String?            @db.VarChar(128)
  manager          User?              @relation("UserManager", fields: [managerId], references: [id])
  subordinates     User[]             @relation("UserManager")
  creator          User?              @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers     User[]             @relation("UserCreatedBy")
  activityLogs     ActivityLog[]
  sessions         Session[]
  assignedProjects AssignedProject[]
  managedProjects  Project[]          @relation("ProjectManager")
  createdRoles     Role[]             @relation("RoleCreatedBy")
  ticketsAssigned  Ticket[]           @relation("TicketAssignedTo")
  ticketsCreated   Ticket[]           @relation("TicketAssignedBy")
  ticketComments   TicketComment[]
  fromTransitions  TicketTransition[] @relation("TransitionFromEmployee")
  toTransitions    TicketTransition[] @relation("TransitionToEmployee")
  notificationFrom Notification[]     @relation("NotificationFrom")
  notificationTo   Notification[]     @relation("NotificationTo")
  chatRoomsCreated ChatRoom[]         @relation("ChatCreatedBy")
  participants     Participant[]
  messages         Message[]
  organization     Organization[]
  membership       Membership[]
  token            Token[]
  TokenCreatedBy   Token[]            @relation("TokenCreatedBy")
  queueAgents      QueueAgent[]
}

model Organization {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  teamSize      Int?
  code          String          @unique
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tickets       Ticket[]
  user          User?           @relation(fields: [createdBy], references: [id])
  createdBy     String          @db.VarChar(128)
  membership    Membership[]
  role          Role[]
  tokens        Token[]
  email         EmailProvider[]
  customer      Customer[]
  emailMessages EmailMessage[]
  queues        Queue[]
  queueAgents   QueueAgent[]
}

model Membership {
  id             String        @id @default(uuid()) @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String        @db.Uuid
  user           User?         @relation(fields: [userId], references: [id])
  userId         String        @db.VarChar(128)
  role           Role?         @relation(fields: [roleId], references: [id])
  roleId         String        @db.Uuid

  @@unique([organizationId, userId])
}

model Role {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique
  name             String
  description      String?
  permissions      Json
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  creator          User?             @relation("RoleCreatedBy", fields: [createdBy], references: [id])
  createdBy        String            @db.VarChar(128)
  organization     Organization?     @relation(fields: [organizationId], references: [id])
  organizationId   String            @db.Uuid
  assignedProjects AssignedProject[]
  membership       Membership[]
  tokens           Token[]
}

enum TokenType {
  INVITE_USER
  RESET_PASSWORD
  CHANGE_EMAIL
  CHANGE_USERNAME
  VERIFY_EMAIL
}

enum TokeStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

model Token {
  id             String        @id @default(uuid())
  email          String
  token          String        @unique
  type           TokenType
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?       @db.Uuid
  role           Role?         @relation(fields: [roleId], references: [id])
  roleId         String?       @db.Uuid
  status         TokeStatus    @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User?         @relation(fields: [userId], references: [id])
  userId         String?       @db.VarChar(128)
  TokenCreatedBy User?         @relation("TokenCreatedBy", fields: [createdBy], references: [id])
  createdBy      String        @db.VarChar(128)
  meteData       Json?
}

enum ProviderType {
  SMTP
  RESEND
  MAILTRAP
}

// ================================= EMAIL ===================================
model EmailProvider {
  id             String        @id @default(uuid())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String        @db.Uuid
  providerType   ProviderType
  isPrimary      Boolean       @default(false)
  active         Boolean       @default(true)
  credentials    Json
  webhookSecret  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  from           String        @unique

  @@unique([organizationId, credentials, providerType])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model EmailMessage {
  id             String           @id @default(uuid()) @db.Uuid
  ticketId       String           @db.Uuid
  ticket         Ticket           @relation(fields: [ticketId], references: [id])
  organizationId String           @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id])
  direction      MessageDirection
  fromEmail      String           @db.VarChar(255)
  toEmail        String           @db.VarChar(255)
  subject        String           @db.VarChar(500)
  bodyHtml       String?          @db.Text
  bodyText       String?          @db.Text
  messageId      String           @unique @db.VarChar(255)
  inReplyTo      String?          @db.VarChar(255)
  references     String?          @db.Text
  createdAt      DateTime         @default(now())

  @@index([ticketId])
  @@index([organizationId])
  @@index([messageId])
}

model Level {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  order           Int
  etaMinutes      Int
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  fromTransitions TicketTransition[] @relation("TransitionFromLevel")
  toTransitions   TicketTransition[] @relation("TransitionToLevel")
}

//  ============================ ACTIVITY / SESSIONS ==============================

model ActivityLog {
  id            String   @id @default(uuid()) @db.Uuid
  entityName    String?
  entityId      String?
  action        String
  description   String?
  logStatus     String?
  metaData      Json?
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  performedById String?  @db.VarChar(128)
  performer     User?    @relation(fields: [performedById], references: [id])
}

model Session {
  id        String   @id
  userId    String   @db.VarChar(128)
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

//  ============================ PROJECTS ==============================

model Project {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique @db.VarChar(128)
  name             String?
  description      String?
  priority         Priority          @default(MEDIUM)
  tags             Json?
  isDraft          Boolean           @default(true)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  managerId        String?           @db.VarChar(128)
  manager          User?             @relation("ProjectManager", fields: [managerId], references: [id])
  assignedProjects AssignedProject[]

  @@index([id, code])
}

model AssignedProject {
  id         String   @id @default(uuid()) @db.Uuid
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String   @db.VarChar(128)
  projectId  String   @db.Uuid
  roleId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])

  @@index([projectId, roleId])
}

//  ============================ QUEUE / SLA ==============================
model Queue {
  id                       String        @id @default(uuid())
  name                     String
  description              String?
  organization             Organization? @relation(fields: [organizationId], references: [id])
  organizationId           String        @db.Uuid
  firstResponseTimeMinutes Int
  resolutionTimeMinutes    Int
  active                   Boolean       @default(true)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  queueAgents              QueueAgent[]
  ticket                   Ticket[]
}

model QueueAgent {
  id             String        @id @default(uuid()) @db.Uuid
  user           User?         @relation(fields: [agentId], references: [id])
  agentId        String
  queue          Queue?        @relation(fields: [queueId], references: [id])
  queueId        String
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String        @db.Uuid
}

//  ============================ TICKET MANAGEMENT ==============================

model Ticket {
  id                  String             @id @default(uuid()) @db.Uuid
  code                String             @unique
  subject             String
  category            String?
  tags                Json?
  recommendedSolution String?
  note                String?
  rootCause           String?
  resolution          String?
  description         String             @db.Text
  status              TicketStatus       @default(OPEN)
  priority            Priority           @default(MEDIUM)
  attachments         Json?
  active              Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  organization        Organization?      @relation(fields: [organizationId], references: [id])
  organizationId      String?            @db.Uuid
  customerId          String?            @db.Uuid
  assignedTo          String?            @db.VarChar(128)
  assignedBy          String?            @db.VarChar(128)
  assignedByUser      User?              @relation("TicketAssignedBy", fields: [assignedBy], references: [id])
  assignedToUser      User?              @relation("TicketAssignedTo", fields: [assignedTo], references: [id])
  customer            Customer?          @relation(fields: [customerId], references: [id])
  transitions         TicketTransition[]
  comments            TicketComment[]
  emailMessages       EmailMessage[]
  queue               Queue?             @relation(fields: [queueId], references: [id])
  queueId             String?

  @@index([assignedTo, assignedBy, customerId, organizationId])
}

model TicketComment {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @db.Uuid
  authorId   String   @db.VarChar(128)
  comment    String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  author     User     @relation(fields: [authorId], references: [id])
}

model TicketTransition {
  id             String        @id @default(uuid()) @db.Uuid
  ticketId       String?       @db.Uuid
  fromLevelId    String?       @db.Uuid
  toLevelId      String?       @db.Uuid
  fromEmployeeId String?       @db.VarChar(128)
  toEmployeeId   String?       @db.VarChar(128)
  changedBy      String?
  note           String?
  fromPriority   Priority?
  toPriority     Priority?
  fromStatus     TicketStatus?
  toStatus       TicketStatus?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  ticket         Ticket?       @relation(fields: [ticketId], references: [id])
  fromEmployee   User?         @relation("TransitionFromEmployee", fields: [fromEmployeeId], references: [id])
  toEmployee     User?         @relation("TransitionToEmployee", fields: [toEmployeeId], references: [id])
  fromLevel      Level?        @relation("TransitionFromLevel", fields: [fromLevelId], references: [id])
  toLevel        Level?        @relation("TransitionToLevel", fields: [toLevelId], references: [id])
}

//  ============================ CUSTOMER SUPPORT ==============================
model CustomerIdentity {
  id       String     @id @default(uuid()) @db.Uuid
  email    String     @unique @db.VarChar(255)
  // Global metadata (e.g., global opt-out, primary language)
  customer Customer[] // Link to all their organization-specific profiles
}

model Customer {
  id             String           @id @default(uuid()) @db.Uuid
  identityId     String           @db.Uuid
  identity       CustomerIdentity @relation(fields: [identityId], references: [id])
  organizationId String           @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id])
  name           String?          @db.VarChar(255)
  isActive       Boolean          @default(true)

  tickets Ticket[]

  // One identity can only have one profile per organization.
  @@unique([organizationId, identityId])
}

model FeatureRequest {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  title       String
  description String
  useCase     String
  priority    Priority @default(LOW)
  votes       Int      @default(0)
  status      String   @default("new")
  attachments Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

model FeedBack {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  rating      Int
  attachments Json?
  comment     String?
  createdAt   DateTime @default(now())

  @@index([customerId])
}

//  ============================ CHATS / ROOMS ==============================

model ChatRoom {
  id           String        @id @unique @default(uuid())
  chatId       String        @unique
  chatType     String
  roomName     String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  createdBy    String        @db.VarChar(128)
  creator      User          @relation("ChatCreatedBy", fields: [createdBy], references: [id])
  participants Participant[]
  messages     Message[]
}

model Participant {
  id        String   @id @unique @default(uuid())
  chatId    String
  userId    String   @db.VarChar(128)
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  chatRoom  ChatRoom @relation(fields: [chatId], references: [chatId])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([chatId, userId])
}

model Message {
  id          String    @id @unique @default(uuid())
  chatId      String
  senderId    String    @db.VarChar(128)
  message     String    @db.Text
  iv          String
  tag         String
  isDelivered Boolean   @default(false)
  isRead      Boolean   @default(false)
  isArchived  Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  chatRoom    ChatRoom  @relation(fields: [chatId], references: [chatId])
  sender      User      @relation(fields: [senderId], references: [id])
}

//  ============================ NOTIFICATIONS ==============================

model Notification {
  id        String   @id @unique @default(uuid())
  message   String
  isRead    Boolean  @default(false)
  fromId    String?  @db.VarChar(128)
  toId      String?  @db.VarChar(128)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  fromUser  User?    @relation("NotificationFrom", fields: [fromId], references: [id])
  toUser    User?    @relation("NotificationTo", fields: [toId], references: [id])
}
