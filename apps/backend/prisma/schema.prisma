generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//  ============================ ENUMS ==============================

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}

//  ============================ USERS / ROLES / ORG ==============================

model User {
  id                  String             @id @unique @default(uuid()) @db.VarChar(128)
  code                String             @unique
  email               String             @unique
  phoneNo             String?            @unique
  passwordHash        String             @unique
  passwordChangeAt    DateTime?
  passwordResetToken  String?            @unique
  passwordResetExpire DateTime?
  avatar              String?
  username            String?
  location            String?
  active              Boolean            @default(true)
  isOnboarded         Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  roleId              String?            @db.Uuid
  managerId           String?            @db.VarChar(128)
  createdBy           String?            @db.VarChar(128)
  manager             User?              @relation("UserManager", fields: [managerId], references: [id])
  subordinates        User[]             @relation("UserManager")
  creator             User?              @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers        User[]             @relation("UserCreatedBy")
  activityLogs        ActivityLog[]
  sessions            Session[]
  assignedProjects    AssignedProject[]
  managedProjects     Project[]          @relation("ProjectManager")
  createdRoles        Role[]             @relation("RoleCreatedBy")
  ticketsAssigned     Ticket[]           @relation("TicketAssignedTo")
  ticketsCreated      Ticket[]           @relation("TicketAssignedBy")
  ticketComments      TicketComment[]
  fromTransitions     TicketTransition[] @relation("TransitionFromEmployee")
  toTransitions       TicketTransition[] @relation("TransitionToEmployee")
  customersCreated    Customer[]         @relation("CustomerCreator")
  notificationFrom    Notification[]     @relation("NotificationFrom")
  notificationTo      Notification[]     @relation("NotificationTo")
  chatRoomsCreated    ChatRoom[]         @relation("ChatCreatedBy")
  participants        Participant[]
  messages            Message[]
  organization        Organization[]
  membership          Membership[]

  @@index([email, phoneNo, code])
}

model Organization {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  teamSize    Int?
  code        String       @unique
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tickets     Ticket[]
  user        User?        @relation(fields: [createdBy], references: [id])
  createdBy   String       @db.VarChar(128)
  membership  Membership[]
  role        Role[]
  invite      Invite[]
}

model Membership {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String        @db.Uuid
  user           User?         @relation(fields: [userId], references: [id])
  userId         String        @db.VarChar(128)
  role           Role?         @relation(fields: [roleId], references: [id])
  roleId         String        @db.Uuid

  @@unique([organizationId, userId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Role {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String            @unique
  name             String
  description      String?
  permissions      Json
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  creator          User?             @relation("RoleCreatedBy", fields: [createdBy], references: [id])
  createdBy        String            @db.VarChar(128)
  organization     Organization?     @relation(fields: [organizationId], references: [id])
  organizationId   String            @db.Uuid
  assignedProjects AssignedProject[]
  membership       Membership[]
  invite           Invite[]
}

model Invite {
  id             String        @id @default(uuid())
  email          String
  token          String        @unique
  status         InviteStatus  @default(PENDING)
  invitedBy      String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?       @db.Uuid
  role           Role?         @relation(fields: [roleId], references: [id])
  roleId         String?       @db.Uuid
}

model Level {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  order           Int
  etaMinutes      Int
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tickets         Ticket[]
  fromTransitions TicketTransition[] @relation("TransitionFromLevel")
  toTransitions   TicketTransition[] @relation("TransitionToLevel")
}

//  ============================ ACTIVITY / SESSIONS ==============================

model ActivityLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityName    String?
  entityId      String?
  action        String
  description   String?
  logStatus     String?
  metaData      Json?
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  performedById String?  @db.VarChar(128)
  performer     User?    @relation(fields: [performedById], references: [id])
}

model Session {
  id        String   @id
  userId    String   @db.VarChar(128)
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

//  ============================ PROJECTS ==============================

model Project {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String            @unique @db.VarChar(128)
  name             String?
  description      String?
  priority         Priority          @default(MEDIUM)
  tags             Json?
  isDraft          Boolean           @default(true)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  managerId        String?           @db.VarChar(128)
  manager          User?             @relation("ProjectManager", fields: [managerId], references: [id])
  assignedProjects AssignedProject[]
  tickets          Ticket[]
  customers        Customer[]

  @@index([id, code])
}

model AssignedProject {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String   @db.VarChar(128)
  projectId  String   @db.Uuid
  roleId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])

  @@index([projectId, roleId])
}

//  ============================ TICKET MANAGEMENT ==============================

model Ticket {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String             @unique
  subject             String
  category            String
  tags                Json?
  recommendedSolution String?
  note                String?
  rootCause           String?
  resolution          String?
  description         String             @db.Text
  status              TicketStatus       @default(OPEN)
  priority            Priority           @default(MEDIUM)
  attachments         Json?
  active              Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  levelId             String?            @db.Uuid
  projectId           String?            @db.Uuid
  departmentId        String?            @db.Uuid
  customerId          String?            @db.Uuid
  assignedTo          String?            @db.VarChar(128)
  assignedBy          String?            @db.VarChar(128)
  assignedByUser      User?              @relation("TicketAssignedBy", fields: [assignedBy], references: [id])
  assignedToUser      User?              @relation("TicketAssignedTo", fields: [assignedTo], references: [id])
  customer            Customer?          @relation(fields: [customerId], references: [id])
  level               Level?             @relation(fields: [levelId], references: [id])
  project             Project?           @relation(fields: [projectId], references: [id])
  department          Organization?      @relation(fields: [departmentId], references: [id])
  transitions         TicketTransition[]
  comments            TicketComment[]

  @@index([assignedTo, assignedBy, customerId, departmentId, levelId, projectId, status])
}

model TicketComment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId   String   @db.Uuid
  authorId   String   @db.VarChar(128)
  comment    String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  author     User     @relation(fields: [authorId], references: [id])
}

model TicketTransition {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId       String?       @db.Uuid
  fromLevelId    String?       @db.Uuid
  toLevelId      String?       @db.Uuid
  fromEmployeeId String?       @db.VarChar(128)
  toEmployeeId   String?       @db.VarChar(128)
  changedBy      String?
  note           String?
  fromPriority   Priority?
  toPriority     Priority?
  fromStatus     TicketStatus?
  toStatus       TicketStatus?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  ticket         Ticket?       @relation(fields: [ticketId], references: [id])
  fromEmployee   User?         @relation("TransitionFromEmployee", fields: [fromEmployeeId], references: [id])
  toEmployee     User?         @relation("TransitionToEmployee", fields: [toEmployeeId], references: [id])
  fromLevel      Level?        @relation("TransitionFromLevel", fields: [fromLevelId], references: [id])
  toLevel        Level?        @relation("TransitionToLevel", fields: [toLevelId], references: [id])
}

//  ============================ CUSTOMER SUPPORT ==============================

model Customer {
  id              String           @id @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId      String           @unique @db.VarChar(128)
  email           String?          @db.VarChar(255)
  name            String?          @db.VarChar(255)
  phoneNumber     String?          @db.VarChar(20)
  avatar          String?          @db.VarChar(500)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String?          @db.VarChar(128)
  projectId       String?          @db.Uuid
  creator         User?            @relation("CustomerCreator", fields: [createdBy], references: [id])
  project         Project?         @relation(fields: [projectId], references: [id])
  tickets         Ticket[]
  featureRequests FeatureRequest[]
  feedback        FeedBack[]

  @@index([externalId])
}

model FeatureRequest {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String   @db.Uuid
  title       String
  description String
  useCase     String
  priority    Priority @default(LOW)
  votes       Int      @default(0)
  status      String   @default("new")
  attachments Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model FeedBack {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String   @db.Uuid
  rating      Int
  attachments Json?
  comment     String?
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

//  ============================ CHATS / ROOMS ==============================

model ChatRoom {
  id           String        @id @unique @default(uuid())
  chatId       String        @unique
  chatType     String
  roomName     String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  createdBy    String        @db.VarChar(128)
  creator      User          @relation("ChatCreatedBy", fields: [createdBy], references: [id])
  participants Participant[]
  messages     Message[]
}

model Participant {
  id        String   @id @unique @default(uuid())
  chatId    String
  userId    String   @db.VarChar(128)
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  chatRoom  ChatRoom @relation(fields: [chatId], references: [chatId])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([chatId, userId])
}

model Message {
  id          String    @id @unique @default(uuid())
  chatId      String
  senderId    String    @db.VarChar(128)
  message     String    @db.Text
  iv          String
  tag         String
  isDelivered Boolean   @default(false)
  isRead      Boolean   @default(false)
  isArchived  Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  chatRoom    ChatRoom  @relation(fields: [chatId], references: [chatId])
  sender      User      @relation(fields: [senderId], references: [id])
}

//  ============================ NOTIFICATIONS ==============================

model Notification {
  id        String   @id @unique @default(uuid())
  message   String
  isRead    Boolean  @default(false)
  fromId    String?  @db.VarChar(128)
  toId      String?  @db.VarChar(128)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  fromUser  User?    @relation("NotificationFrom", fields: [fromId], references: [id])
  toUser    User?    @relation("NotificationTo", fields: [toId], references: [id])
}
