model ChatRoom {
  id          String        @id @unique @default(uuid())
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  chatId      String        @unique
  chatType    String
  roomName    String?
  User        User          @relation(fields: [cratedBy], references: [id])
  cratedBy    String
  Participant Participant[]
  Messaging   Messaging[]
}

model Participant {
  id        String   @id @unique @default(uuid())
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  ChatRoom  ChatRoom @relation(fields: [chatId], references: [chatId])
  chatId    String
  User      User     @relation(fields: [userId], references: [id])
  userId    String
  isActive  Boolean  @default(false)

  @@unique([chatId, userId])
}

model Messaging {
  id          String    @id @unique @default(uuid())
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  User        User?     @relation(fields: [senderId], references: [id])
  senderId    String
  message     String
  iv          String
  tag         String
  readAt      DateTime?
  isDelivered Boolean   @default(false)
  isRead      Boolean   @default(false)
  isAchieve   Boolean   @default(false)
  ChatRoom    ChatRoom? @relation(fields: [chatId], references: [chatId])
  chatId      String
}

model Notification {
  id               String   @id @unique @default(uuid())
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  message          String
  isRead           Boolean  @default(false)
  NotificationFrom User?    @relation("notificationFrom", fields: [from], references: [id])
  from             String?
  NotificationTo   User?    @relation("notificationTo", fields: [to], references: [id])
  to               String?
}
