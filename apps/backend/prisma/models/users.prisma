model User {
  id            String          @id @unique @default(uuid())
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime?       @updatedAt @db.Timestamptz(6)
  uuid          String          @unique
  nationalId    String
  idType        String
  firstName     String
  lastName      String
  email         String          @unique
  phoneNumber   String
  dateOfBirth   DateTime
  gender        String?
  address       String
  jobTitle      String
  hireDate      DateTime
  image         String?
  active        Boolean         @default(true)
  description   String?
  Authorization Authorization[]

  NotificationFrom Notification[]  @relation("notificationFrom")
  NotificationTo   Notification[]  @relation("notificationTo")
  ChatCreatedBy    ChatRoom[]
  Participant      Participant[]
  Messaging        Messaging[]
  LoginActivity    LoginActivity[]
  departmentId     Int
}

model TeamMembers {
  id              String         @id @unique @default(uuid())
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)
  AssignedTo      Authorization? @relation("assignedTo", fields: [assignedTo], references: [userId])
  assignedTo      String
  AssignedBy      Authorization? @relation("assignedBy", fields: [assignedBy], references: [userId])
  assignedBy      String
  User            Authorization? @relation("userId", fields: [userId], references: [userId])
  userId          String         @unique
  authorization   Authorization? @relation(fields: [authorizationId], references: [id])
  authorizationId String?

  @@unique([assignedTo, assignedBy, userId])
}
