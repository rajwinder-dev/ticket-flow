{
  "compilerOptions": {
    "types": ["node"],
    "useUnknownInCatchVariables": false,
    "target": "es2022",
    "module": "commonjs",
    "outDir": "./dist",
    "sourceMap": true,
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./node_modules/@types", "src", "tests"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests"],
  "exclude": ["node_modules", "dist", "tests"]
}
