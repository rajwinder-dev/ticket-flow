{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "rootDir": "src",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": false,
    // "allowImportingTsExtensions": true,
    "outDir": "dist",
    "jsx": "react-jsx",
    "lib": ["esnext"],
    "types": ["node"],
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*.ts"]
}
